## vox_room, in Docker behind Traefik. Copy to docker/.env and edit.
##
##   cd docker
##   cp .env.example .env
##   $EDITOR .env
##   docker compose build
##   docker compose up -d
##   docker compose exec vox_room vox_room invite Ryan
##
## This file is both the compose interpolation source (the Traefik labels)
## and the container's environment, so the room reads the same variables
## it would on the host (ROOM.md lists them all). It is deliberately not
## the repository's own .env, which belongs to `just` and rpg_vox.

# ---------------------------------------------------------------- Traefik
## The public name. Browsers only allow the microphone on HTTPS, so this
## has to be a real name with a real certificate.
VOX_ROOM_TRAEFIK_HOST=room.example.com

## Names the router, its service and its middlewares. Keep it unique
## among everything else Traefik is proxying.
VOX_ROOM_ROUTER=vox-room

## Your Traefik's TLS entrypoint. The certificate comes from Traefik's
## own store, matched on the host name, so there is no resolver to name.
VOX_ROOM_TRAEFIK_ENTRYPOINT=rpgvox

## The public port that entrypoint listens on. 443 is the standard one;
## anything else has to appear in the invite links too, which is what
## VOX_ROOM_URL below is for.
VOX_ROOM_PUBLIC_PORT=7331

## The address invite links point at. `just config` offers it built from
## the host and the port above; on 443 you can drop the `:443`.
VOX_ROOM_URL=https://${VOX_ROOM_TRAEFIK_HOST}:${VOX_ROOM_PUBLIC_PORT}

## Who may reach the room at all. 0.0.0.0/0 is everyone; narrow it to
## your own ranges and the invite links become a second lock, not the
## only one.
VOX_ROOM_IP_SOURCERANGE=0.0.0.0/0

## Requests per second per client IP, and the burst. The room is a few
## HTTP requests plus one long-lived WebSocket per tab, so this is
## already far more than it needs.
VOX_ROOM_RATELIMIT_AVERAGE=20
VOX_ROOM_RATELIMIT_BURST=60

## The image tag `docker compose build` writes and `up` runs.
VOX_ROOM_IMAGE=vox_room:latest

# ------------------------------------------------------ speech-to-text
## parakeet (English, ~660 MB, the most accurate), sensevoice
## (multilingual, ~230 MB) or none (no transcription, and so no AI).
##
## Downloaded from the sherpa-onnx releases into the `models` volume the
## first time the container starts, along with the small streaming model
## that puts words on screen while someone is still talking. Expect the
## first `up` to sit there for a few minutes; after that the volume has
## them and startup is seconds. `docker compose logs -f` shows progress.
VOX_ROOM_STT_MODEL=parakeet

# ---------------------------------------------------------------- the AI
## An OpenAI-compatible endpoint ending in /v1, reachable from wherever
## the Docker daemon runs -- which with a remote context is the remote
## host, not your workstation. For a model server on that same host,
## http://host.docker.internal:9931/v1 works (docker-compose.yaml maps
## the name); otherwise give it a real URL.
VOX_SCRIBE_LLM_URL=https://llm.example.com/v1
VOX_SCRIBE_LLM_MODEL=nemotron-3-nano-4b
## Blank is fine for a local llama.cpp that doesn't check.
VOX_SCRIBE_LLM_KEY=

## What the AI is called, and the other spellings speech-to-text makes of
## it. In "when named" mode it only answers when someone says one.
VOX_ROOM_AGENT_NAME=Vox
VOX_ROOM_AGENT_ALIASES=Vocks,Fox,Box

## How hard the AI may think before it answers (never spoken aloud):
## none, low, medium or high. On a local llama.cpp or vLLM this turns the
## chat template's thinking on or off; on OpenAI it is the reasoning
## effort. Thinking costs latency, and a voice room feels every second of
## it -- but a game master that cannot think runs a worse game.
VOX_ROOM_REASONING=low

## Which API to speak: auto, responses or chat. It matters because
## OpenAI's reasoning models refuse the AI's tools on /chat/completions
## unless the thinking is off entirely, and the room needs those tools
## for the cards and the games -- so on that API it plays every game
## without thinking. /v1/responses takes both. A local llama.cpp or vLLM
## has only /chat/completions. `auto` asks for /responses once and
## remembers if there isn't one, so neither needs configuring.
VOX_ROOM_LLM_API=auto

## Let the AI look things up in the lobby, using the endpoint's own web
## search (OpenAI's /v1/responses). Restaurants, opening hours, news --
## anything it would otherwise guess at. Lobby only, never inside a game.
## Needs an endpoint that has it: a local llama.cpp does not, and each
## search is an extra request you pay for.
VOX_ROOM_SEARCH=false

## Quiet after the last words before the AI may answer, and the run of
## speech over it that cuts it off for good.
VOX_ROOM_REPLY_AFTER_MS=1200
VOX_ROOM_CONFIRM_MS=300
## Entries of the conversation sent with each turn.
VOX_ROOM_HISTORY=60

## The system prompt; `{name}` and `{people}` are filled in. Leave this
## commented out for the built-in one -- set but empty means an empty
## prompt, which is not the same thing.
#VOX_ROOM_PROMPT=You are {name}, in a room with {people}.

# ------------------------------------------------------------- the voice
## qwen3 (a vllm-omni server), kokoro (a local model, downloaded into the
## models volume) or none (replies appear silently, at reading pace).
VOX_ROOM_TTS=qwen3

## Qwen3-TTS: a /v1/audio/speech endpoint, as for pi-tts. Same reachability
## rule as the LLM URL above.
## Comment this out when VOX_ROOM_TTS is kokoro or none: set but empty
## still counts as "use Qwen3-TTS", at an empty address.
VOX_ROOM_TTS_URL=https://qwen3-tts.example.com

## Bearer token for that server, if it wants one, and the model id to ask
## for. Leave the model blank and the request doesn't name one, which is
## right for a server that serves exactly one.
VOX_ROOM_TTS_KEY=
VOX_ROOM_TTS_MODEL=
VOX_ROOM_VOICE=aiden
## How it should speak, e.g. "calm and warm". Blank for plain.
VOX_ROOM_INSTRUCT=
VOX_ROOM_LANGUAGE=English
## Other languages the door offers, comma-separated and spelled out in
## English. With one chosen, the AI answers in every language somebody
## is listening in, and typed messages are translated too. Needs
## VOX_ROOM_TTS=qwen3 for them to be spoken as well as written.
VOX_ROOM_LANGUAGES=
## Who translates: `openai` asks the reply model (about two seconds a
## line, and it keeps a URL or a command intact of its own accord), or
## `local` asks Marian models on the CPU -- about seventeen times
## faster, and nothing leaves the container. The first start downloads
## them, roughly 80 MB a direction. With `local`, put anything that has
## to arrive exactly in backticks: it is the only thing that protects
## it. See ROOM.md.
VOX_ROOM_TRANSLATE=openai

## Say what people say to the people who don't speak it: a voice reading
## each utterance a phrase behind whoever said it, with the voices being
## interpreted ducked under it -- a booth at a conference, not a
## subtitle. Costs a translation and a Qwen3 request per utterance per
## listening language; `false` leaves only the AI and typed messages
## translated.
VOX_ROOM_INTERPRET=true
## The interpreters' voice, which is deliberately not the AI's: the one
## thing a listener has to be able to tell is which is which.
VOX_ROOM_INTERPRETER_VOICE=ryan

## Kokoro's voice, when VOX_ROOM_TTS=kokoro.
VOX_ROOM_KOKORO_VOICE=am_michael

# --------------------------------------------------- split-horizon DNS
## Pin one host name to one address inside the container, for when the
## container's resolver gives it an address it can't reach -- a private
## service whose public DNS points somewhere else. The URLs above keep
## the name, so TLS and the Host header are unaffected.
##
## `host-gateway` is the Docker host itself, which is the answer when the
## service sits behind the same Traefik as this room. Leave both blank
## for no pinning.
VOX_ROOM_PIN_HOST=
VOX_ROOM_PIN_IP=

# ------------------------------------------------------------------ logs
## tracing filter: info, debug, vox_room=debug, …
RUST_LOG=info,ort=warn

# -------------------------------------------------------------------- note
## Blank is not the same as unset. docker compose passes `FOO=` through
## as an empty variable, and vox_room takes it literally: an empty
## VOX_ROOM_PROMPT is an empty system prompt, an empty VOX_ROOM_TTS_URL
## is a TTS server at no address, an empty VOX_ROOM_TTS fails to parse.
## Comment a line out instead of emptying it.
