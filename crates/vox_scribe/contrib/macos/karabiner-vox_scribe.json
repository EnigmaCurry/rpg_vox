{
  "title": "vox_scribe",
  "rules": [
    {
      "description": "Mic/F5 key: start vox_scribe --once, or finish the running one",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f5"
          },
          "to": [
            {
              "shell_command": "~/.local/bin/vox_scribe stop-once 2>/dev/null || open -a Terminal ~/.local/bin/vox_scribe-once.terminal"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "dictation"
          },
          "to": [
            {
              "shell_command": "~/.local/bin/vox_scribe stop-once 2>/dev/null || open -a Terminal ~/.local/bin/vox_scribe-once.terminal"
            }
          ]
        }
      ]
    }
  ]
}
