{
  "title": "scribe",
  "rules": [
    {
      "description": "Mic/F5 key: start scribe --once, or finish the running one",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f5"
          },
          "to": [
            {
              "shell_command": "@BIN@/scribe stop-once 2>/dev/null || @LAUNCH@"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "dictation"
          },
          "to": [
            {
              "shell_command": "@BIN@/scribe stop-once 2>/dev/null || @LAUNCH@"
            }
          ]
        }
      ]
    }
  ]
}
