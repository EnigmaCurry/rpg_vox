<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Not optional, and not obvious: Chromium's Android audio manager
         selects a communication device before it will open a capture
         stream, and without this every getUserMedia in the WebView fails
         with NotReadableError ("Could not start audio source") and
         `Unable to select communication device!` in the log. It is a
         normal permission, so declaring it is the whole of granting it. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- A headset with a talk button of its own. The button is not a
         key and arrives as a vendor-specific hands-free AT command,
         which Android only forwards to an app holding this; see
         HeadsetPtt.kt. A runtime permission, and the one thing the app
         asks for that it can do without: deny it and the volume keys
         are still the talk key. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Holding the icon is the way to the talk key. It has to
                 be declared on the launcher activity rather than on the
                 one it opens. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Which volume key talks, if either. A dialog over whatever is
             behind it; the call carries on underneath. Exported because
             the launcher is what starts it, which is safe enough: it is
             three radio buttons over one preference of this app's own,
             and there is nothing behind it to reach. -->
        <activity
            android:name=".TalkKeyActivity"
            android:exported="true"
            android:label="@string/talk_key_title"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Dialog" />
        <!-- What keeps the call alive while the screen is off: Android
             keeps the process scheduled, and the WebView inside it goes
             on holding the room. See README.md. -->
        <service
            android:name=".RoomService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
