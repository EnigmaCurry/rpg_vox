# qwen3-tts deployment config template.
#
# Copy this file to `.env` (same directory) and set the three Traefik-
# routable hostnames below. `.env` is gitignored; `.env-dist` is committed
# as documentation of the required variables.
#
# The subdomain pattern used by the maintainer is `qwen3-tts[-mode].<base>`
# but any three distinct Host()-matchable hostnames work — they need only
# resolve to your Traefik host and have TLS certs (wildcard or per-name)
# provisioned however your traefik is configured.

# Docker daemon this stack talks to. Justfile exports this as $DOCKER_HOST
# for every `docker`/`docker compose` invocation, so build+deploy hits the
# remote GPU box rather than the local docker socket. Common values:
#   ssh://user@host              remote docker over SSH (uses ~/.ssh)
#   unix:///var/run/docker.sock  local daemon (default socket)
#   tcp://host:2375              remote docker over TCP (usually with TLS)
# `just gpu-host` also parses this to reach the host directly; that recipe
# only supports the ssh:// form.
QWEN3_TTS_DOCKER_HOST=ssh://user@your-docker-host

# Preset speakers + `instruct`-style modulation (CustomVoice model).
QWEN3_TTS_PRESETS_HOST=qwen3-tts.example.com

# 3-second reference-audio voice clone (Base model).
QWEN3_TTS_CLONE_HOST=qwen3-tts-clone.example.com

# Voice generated from a free-text description (VoiceDesign model).
QWEN3_TTS_DESIGN_HOST=qwen3-tts-design.example.com
